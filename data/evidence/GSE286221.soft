!Sample_last_update_date = Feb 18 2025
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Brain
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = tissue: Brain
!Sample_characteristics_ch1 = cell type: Murine Microglia
!Sample_characteristics_ch1 = treatment: Mock T cells
!Sample_treatment_protocol_ch1 = Mice were treated with either tumor-clearing CD19 CAR T cells or mock T cell controls, and microglia was extacted from full cerebrum of mice at endpoint
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = cerebrum (whole brain minus the cerebellum) was dissected out and the tissue was digested and processed using the Multi Tissue Dissociation Kit (Miltenyi Biotech) followed by debris removal (Miltenyi Biotech).  Mouse F4/80+ cell selection was performed using F4/80+ selection kit (Biolegend). The viability of cells after the isolation process was typically over 90%.
!Sample_extract_protocol_ch1 = F4/80+ cells were then processed with the Nextera XT Library Prep Kit (Illumina) to generate sequencing libraries following the manufacturer’s instructions.
!Sample_description = Library name: H14_S20_R1_001.fastq.gz
!Sample_description = H14_S20.genes.results
!Sample_data_processing = Reads were mapped to mm38 annotation using STAR alignment (version 2.5.4b) and raw transcript expression was quantified as transcripts per million (tpm). Differential gene expression and log2 fold change calculations were determined using the DESeq2 (v.1.36.0) package in R. Volcano plot analysis was conducted using the R-based EnhancedVolcano (v1.14.0) package (https://github.com/kevinblighe/EnhancedVolcano).
!Sample_data_processing = Assembly: mm38
!Sample_data_processing = Supplementary files format and content: Raw TPM counts of gene abundance for murine microglia in csv format
!Sample_data_processing = Supplementary files format and content: Metadata table with sample key in csv format

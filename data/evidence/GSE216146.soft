^DATABASE = GeoMiame
!Database_name = Gene Expression Omnibus (GEO)
!Database_institute = NCBI NLM NIH
!Database_web_link = http://www.ncbi.nlm.nih.gov/geo
!Database_email = geo@ncbi.nlm.nih.gov
^SERIES = GSE216146
!Series_title = Gamma entrainment using sensory stimuli alleviate chemo brain pathology and cognitive impairment induced by chemotherapy agents
!Series_geo_accession = GSE216146
!Series_status = Public on Dec 04 2024
!Series_submission_date = Oct 19 2022
!Series_last_update_date = Dec 04 2024
!Series_pubmed_id = 38446899
!Series_summary = We are using scRNA-seq to analyze how 40 Hz sensory stimulation can modulate chemo brain pathology in mouse hippocampus.
!Series_overall_design = Chemo brain model animals were generated with cisplatin injection and control groups received PBS injections. To test if Gamma ENtrainment Using Sensory stimuli (GENUS), which utilizes 40 Hz auditory pulse and visual LED flicker in this experiment, was given from the first day of cisplatin injection resulting in four experimental groups (PBS No Stim, PBS Stim, Cisplatin No Stim, Cisplatin Stim) . GENUS was given 1 hr every day for 21 days and animals were sacrificed and hippocampi were collected on the 22nd day. Replicate 1 (D20_6407~6410) contains two hippocampi from one animal per sample and replicate 2 and 3 contains four hippocampi from two animals.
!Series_type = Expression profiling by high throughput sequencing
!Series_contributor = TaeHyun,,Kim
!Series_contributor = Li-Huei,,Tsai
